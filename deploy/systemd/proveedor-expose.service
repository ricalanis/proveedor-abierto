[Unit]
Description=Proveedor Abierto: publish the product URL through NetBird (fallback to the Cloud service)
After=network-online.target netbird.service docker.service
Wants=network-online.target

[Service]
Type=simple
# Credentials: put PA_INVESTIGATOR_PASSWORD (or PA_INVESTIGATOR_PIN) in this root-only file (chmod 600).
EnvironmentFile=/etc/proveedor-abierto/expose.env
ExecStart=/opt/proveedor-abierto/deploy/netbird-expose.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
