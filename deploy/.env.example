# Copy to deploy/.env (gitignored). Values here are for a local rehearsal on the synthetic fixtures;
# on the control-plane VM point PA_LAKE_DIR / PA_CASE_HOST_DIR at the real lake and case.
PA_LAKE_DIR=../.cache/fixtures/lake
PA_CASE_HOST_DIR=../.cache/fixtures/case
PA_BIND_IP=127.0.0.1        # on the VM: the NetBird IP, $(netbird status --ipv4), which the proxy dials
PA_INVESTIGATOR_PORT=8400
# S3 lake instead of a file lake: uncomment, and set the AWS_* keys in the environment, never in this file.
# PA_GOLD_DIR_IN_CONTAINER=
# PA_LAKE_YAML_HOST=../lake.yaml

# NetBird services (deploy/netbird_services.py; fallback deploy/netbird-expose.sh for the product only).
# Secrets come from the environment or a secret manager, never this file.
PA_NAME_PREFIX=proveedor
# PA_INVESTIGATOR_PASSWORD=          product URL: shared password (or PA_INVESTIGATOR_PIN, 6 digits)
# PA_CONSOLE_PORT=8410               Ontofill Console container port (ontofill/console)
# PA_APPROVER_GROUP=approvers        console URL: SSO restricted to this IdP group (or PA_CONSOLE_PIN)
